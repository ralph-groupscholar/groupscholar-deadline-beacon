{
  "name": "groupscholar-deadline-beacon",
  "version": "1.0.0",
  "description": "CLI for tracking scholarship deadlines and generating outreach digests for Group Scholar.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "db:init": "tsx src/cli.ts db-init",
    "db:seed": "tsx src/cli.ts db-seed",
    "test": "vitest run"
  },
  "keywords": [
    "groupscholar",
    "deadlines",
    "cli",
    "postgres"
  ],
  "author": "Ralph",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
